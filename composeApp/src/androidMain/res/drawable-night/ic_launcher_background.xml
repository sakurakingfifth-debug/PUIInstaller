<?xml version="1.0" encoding="utf-8"?>
<!--
  暗色图标底：深色斜向渐变 + 左上角一层柔光。
  参考 ColorOS 暗色图标的观感：不是纯黑，而是从炭灰过渡到近黑，边缘压暗、左上略亮，
  这样在深色壁纸/深色桌面上仍能看出图标轮廓。
  资源限定符 -night：系统切到深色时启动器自动用这一份。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主体渐变：左上 #3A3836 → 右下 #0C0C0C -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF3B3937" />
                <item android:offset="0.45" android:color="#FF232120" />
                <item android:offset="1" android:color="#FF0B0B0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上柔光：让深色底有一点体积感，不至于死板 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="22"
                android:centerY="16"
                android:gradientRadius="86">
                <item android:offset="0" android:color="#14FFFFFF" />
                <item android:offset="0.55" android:color="#08FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
